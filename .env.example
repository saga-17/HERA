# HERA-VLM Environment Configuration

# Set to true to run without GPU models (uses demo responses)
HERA_DEMO_MODE=true

# VLM model (default: Qwen2-VL-7B-Instruct)
# Alternatives: llava-hf/llava-1.5-7b-hf, microsoft/Phi-3-vision-128k-instruct
HERA_VLM_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct

# Quantization (recommended for RTX 4060 8GB)
HERA_USE_4BIT=true
HERA_USE_CPU_FALLBACK=true

# Max generation tokens
HERA_MAX_NEW_TOKENS=1024

# Verification thresholds
HERA_SUPPORTED_THRESHOLD=0.65
HERA_HALLUCINATED_THRESHOLD=0.35
